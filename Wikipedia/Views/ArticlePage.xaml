<Page
    x:Name="ArticleRoot"
    x:Class="Wikipedia.Views.ArticlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar>
            <!-- No x:Uid here: the label is bound so it can switch between
                 save and saved, and a resource would overwrite the binding. -->
            <AppBarButton
                Icon="Favorite"
                Label="{Binding SaveButtonText}"
                Command="{Binding ToggleSaveCommand}" />
            <AppBarButton
                x:Uid="Article_Share"
                Icon="Share"
                Command="{Binding ShareCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    x:Uid="Article_Pin"
                    Icon="Pin"
                    Command="{Binding PinCommand}" />
                <AppBarButton
                    x:Uid="Article_Random"
                    Icon="Shuffle"
                    Command="{Binding RandomCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <!-- Named so the reading direction of the edition can be applied to the
         content alone, leaving the app bar in the interface direction. -->
    <Grid x:Name="ContentRoot">
        <ProgressRing
            IsActive="{Binding IsBusy}"
            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
            VerticalAlignment="Top"
            Margin="0,32,0,0" />

        <StackPanel
            VerticalAlignment="Top"
            Margin="16,24,16,0"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Text="{Binding ErrorMessage}"
                TextWrapping="Wrap"
                Opacity="0.8" />
            <Button
                x:Uid="Article_Retry"
                Margin="0,12,0,0"
                Click="Retry_Click" />
        </StackPanel>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel Margin="16,24,16,24">
                <TextBlock
                    Text="{Binding Title}"
                    Style="{StaticResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />

                <Image
                    Source="{Binding ThumbnailUrl}"
                    MaxHeight="220"
                    Margin="0,16,0,0"
                    Stretch="Uniform"
                    HorizontalAlignment="Left"
                    Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    Text="{Binding Summary}"
                    Margin="0,16,0,0"
                    TextWrapping="Wrap"
                    FontSize="{Binding DataContext.BodyFontSize, ElementName=ArticleRoot}"
                    LineHeight="26" />

                <TextBlock
                    Text="{Binding SectionsHeader}"
                    Margin="0,28,0,8"
                    FontWeight="SemiBold"
                    Opacity="0.7" />

                <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,18">
                                <TextBlock
                                    Text="{Binding Heading}"
                                    FontWeight="SemiBold"
                                    FontSize="20"
                                    Margin="0,10,0,6"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding Body}"
                                    TextWrapping="Wrap"
                                    FontSize="{Binding DataContext.BodyFontSize, ElementName=ArticleRoot}"
                                    LineHeight="26" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
