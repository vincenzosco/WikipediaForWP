<Page
    x:Class="Wikipedia.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- Named so the reading direction of the edition can be applied to the
         results and the query box, leaving the rest of the interface alone. -->
    <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="Search_Title"
            Grid.Row="0"
            Margin="16,24,16,0"
            Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" Margin="16,16,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QueryTextBox"
                x:Uid="SearchBox"
                Grid.Column="0"
                KeyDown="QueryTextBox_KeyDown" />

            <!-- The box text is passed as the command parameter rather than
                 read from the view model's Query property, so the search runs
                 against what the user currently sees. -->
            <Button
                x:Uid="Search_Go"
                Grid.Column="1"
                Margin="8,0,0,0"
                Command="{Binding SearchCommand}"
                CommandParameter="{Binding Text, ElementName=QueryTextBox}" />
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel
                VerticalAlignment="Top"
                Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    x:Uid="Search_Hint"
                    Margin="16,8,16,0"
                    Opacity="0.6"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{Binding EmptyStateText}"
                    Margin="16,8,16,0"
                    Opacity="0.6"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!-- The empty state is suppressed while an error is set, so the
                 error has to be shown here or a failed search renders a
                 completely blank screen. -->
            <StackPanel
                VerticalAlignment="Top"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Margin="16,8,16,0"
                    TextWrapping="Wrap"
                    Opacity="0.75" />
            </StackPanel>

            <ProgressRing
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                VerticalAlignment="Top"
                Margin="0,24,0,0" />

            <ListView
                ItemsSource="{Binding Results}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Results_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,8">
                            <StackPanel Orientation="Horizontal">
                                <Image
                                    Width="52"
                                    Height="52"
                                    Margin="0,0,12,0"
                                    Stretch="UniformToFill"
                                    Source="{Binding ThumbnailUrl}"
                                    Visibility="{Binding ThumbnailUrl, Converter={StaticResource EmptyStringToVisibility}}" />
                                <StackPanel VerticalAlignment="Top" MaxWidth="230">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontWeight="SemiBold"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Description}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Opacity="0.6"
                                        MaxLines="1"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock
                                Text="{Binding Excerpt}"
                                Margin="0,6,0,0"
                                Opacity="0.75"
                                MaxLines="2"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
