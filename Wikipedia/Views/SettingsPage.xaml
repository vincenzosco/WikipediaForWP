<Page
    x:Class="Wikipedia.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,24,16,24">
            <TextBlock
                x:Uid="Settings_Title"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Uid="Settings_LanguageTitle"
                Margin="0,20,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}" />

            <!-- Several hundred editions cannot be browsed in a drop down on a
                 phone, so the list is searched rather than enumerated. -->
            <TextBox
                x:Name="LanguageSearchBox"
                x:Uid="Settings_LanguageSearch"
                Margin="0,10,0,0"
                TextChanged="LanguageSearchBox_TextChanged" />

            <ProgressRing
                IsActive="{Binding IsBusy}"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                HorizontalAlignment="Left"
                Margin="0,10,0,0" />

            <ListView
                ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                MaxHeight="260"
                Margin="0,10,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Each row follows the direction of its own edition,
                             which is what keeps the right to left entries
                             readable inside a left to right page. -->
                        <StackPanel
                            FlowDirection="{Binding IsRightToLeft, Converter={StaticResource BoolToFlowDirection}}">
                            <TextBlock
                                Text="{Binding Name}"
                                TextWrapping="NoWrap"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{Binding Code}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Uid="Settings_NoLanguageMatch"
                Margin="0,8,0,0"
                Opacity="0.6"
                TextWrapping="Wrap"
                Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                x:Uid="Settings_LanguageIncomplete"
                Margin="0,8,0,0"
                Opacity="0.6"
                TextWrapping="Wrap"
                Visibility="{Binding IsListIncomplete, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                Text="{Binding EffectiveLanguageText}"
                Margin="0,8,0,0"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />

            <ComboBox
                x:Uid="Settings_FontSize"
                Margin="0,24,0,0"
                HorizontalAlignment="Stretch"
                SelectedIndex="{Binding FontScaleIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="Settings_FontSmall" />
                <ComboBoxItem x:Uid="Settings_FontNormal" />
                <ComboBoxItem x:Uid="Settings_FontLarge" />
            </ComboBox>

            <ToggleSwitch
                x:Uid="Settings_HistoryEnabled"
                Margin="0,24,0,0"
                IsOn="{Binding IsHistoryEnabled, Mode=TwoWay}" />

            <Button
                x:Uid="Settings_ClearHistory"
                Margin="0,16,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding ClearHistoryCommand}" />

            <Button
                x:Uid="Settings_ClearCache"
                Margin="0,10,0,0"
                HorizontalAlignment="Stretch"
                Command="{Binding ClearCacheCommand}" />

            <TextBlock
                Text="{Binding StatusMessage}"
                Margin="0,20,0,0"
                TextWrapping="Wrap"
                Opacity="0.85"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock
                Text="{Binding ErrorMessage}"
                Margin="0,20,0,0"
                TextWrapping="Wrap"
                Opacity="0.85"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</Page>
