<Page
    x:Class="Wikipedia.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton
                x:Uid="History_Clear"
                Icon="Delete"
                Command="{Binding ClearCommand}" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="History_Title"
            Grid.Row="0"
            Margin="16,24,16,0"
            Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock
                Text="{Binding EmptyStateText}"
                Margin="16,8,16,0"
                VerticalAlignment="Top"
                Opacity="0.6"
                TextWrapping="Wrap"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListView
                ItemsSource="{Binding Entries}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Entries_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,8">
                            <Image
                                Width="44"
                                Height="44"
                                Margin="0,0,12,0"
                                Stretch="UniformToFill"
                                Source="{Binding ThumbnailUrl}"
                                Visibility="{Binding ThumbnailUrl, Converter={StaticResource EmptyStringToVisibility}}" />
                            <StackPanel VerticalAlignment="Center" MaxWidth="240">
                                <TextBlock
                                    Text="{Binding Title}"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding ViewedAt, Converter={StaticResource RelativeTime}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.6" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
