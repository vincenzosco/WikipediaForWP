<Application
    x:Class="Wikipedia.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:Wikipedia.Converters">

    <Application.Resources>
        <ResourceDictionary>
            <!-- Shared by the recent, saved and history lists. -->
            <converters:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:RelativeTimeConverter x:Key="RelativeTime" />
            <converters:BooleanToFlowDirectionConverter x:Key="BoolToFlowDirection" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
