<Page
    x:Name="SavedRoot"
    x:Class="Wikipedia.Views.SavedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Uid="Saved_Title"
            Grid.Row="0"
            Margin="16,24,16,0"
            Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <TextBlock
                Text="{Binding EmptyStateText}"
                Margin="16,8,16,0"
                VerticalAlignment="Top"
                Opacity="0.6"
                TextWrapping="Wrap"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

            <ListView
                ItemsSource="{Binding Articles}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Articles_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image
                                Grid.Column="0"
                                Width="52"
                                Height="52"
                                Margin="0,0,12,0"
                                Stretch="UniformToFill"
                                Source="{Binding ThumbnailUrl}"
                                Visibility="{Binding ThumbnailUrl, Converter={StaticResource EmptyStringToVisibility}}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontWeight="SemiBold"
                                    TextWrapping="NoWrap"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{Binding SavedAt, Converter={StaticResource RelativeTime}}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Opacity="0.6" />
                            </StackPanel>

                            <Button
                                Grid.Column="2"
                                x:Uid="Saved_Remove"
                                VerticalAlignment="Center"
                                Command="{Binding DataContext.RemoveCommand, ElementName=SavedRoot}"
                                CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
